# ─── WartungsDashboard – Environment Configuration ───────────────────────────
# Copy this file to .env and adjust the values before starting the container.
# Never commit the actual .env file to version control.

# ── Database ──────────────────────────────────────────────────────────────────
# Path to the SQLite database file inside the container.
# The directory is mounted as a named Docker volume; do not change the path.
DATABASE_URL=file:/app/data/wartung.db

# ── Session ───────────────────────────────────────────────────────────────────
# REQUIRED: Replace with a long, random string (e.g. `openssl rand -hex 32`)
SESSION_SECRET=change_this_to_a_long_random_secret_in_production

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3067

# ── Seed (optional) ───────────────────────────────────────────────────────────
# Override the default admin credentials used by `npm run db:seed`.
# ADMIN_USER=admin
# ADMIN_PASS=changeme123
